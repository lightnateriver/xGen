#include "acl/acl.h"
#include <ATen/ATen.h>
#include <c10/core/DeviceGuard.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/core/npu/NPUCachingAllocator.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "../op_kernel/swiglu_quant_reuse_kernel.asc"

static std::tuple<at::Tensor,at::Tensor> quant_meta(const at::Tensor& u,int64_t tile,int64_t blocks,int64_t scaleMode) {
    TORCH_CHECK(u.dim()==3 && u.size(2)>0 && u.size(2)%2==0 && u.size(2)<=28672,"[B,S,2F], 1<=F<=14336 required");
    TORCH_CHECK(u.scalar_type()==at::kBFloat16 && u.stride(2)==1 && u.stride(0)>=0 && u.stride(1)>=0,"BF16, last stride=1 required");
    TORCH_CHECK(tile==1024 || tile==2048 || tile==4096,"tile must be 1024,2048,4096 (reused UB budget)");
    TORCH_CHECK(blocks>0 && blocks<=40 && (scaleMode==0 || scaleMode==1),"invalid blocks/scale mode");
    auto rows=u.size(0)*u.size(1);
    return {at::empty({rows,u.size(2)/2},u.options().dtype(at::kChar)),at::empty({rows},u.options().dtype(at::kFloat))};
}
static std::tuple<at::Tensor,at::Tensor> quant_run(const at::Tensor& u,int64_t tile,int64_t blocks,int64_t scaleMode) {
    TORCH_CHECK(u.is_privateuseone(),"NPU input required"); const c10::DeviceGuard guard(u.device());
    auto out=quant_meta(u,tile,blocks,scaleMode); auto q=std::get<0>(out),scale=std::get<1>(out);
    if (u.numel()==0) return out;
    auto stream=c10_npu::getCurrentNPUStream(); auto raw=stream.stream(false);
    c10_npu::NPUCachingAllocator::recordStream(u.storage().data_ptr(),stream);
    c10_npu::NPUCachingAllocator::recordStream(q.storage().data_ptr(),stream);
    c10_npu::NPUCachingAllocator::recordStream(scale.storage().data_ptr(),stream);
    uint64_t rows=u.size(0)*u.size(1),seq=u.size(1),half=u.size(2)/2,sb=u.stride(0),sr=u.stride(1);
    auto call=[u,q,scale,raw,rows,seq,half,sb,sr,tile,blocks,scaleMode]() -> int {
        h3_swiglu_quant_reuse_kernel<<<blocks,nullptr,raw>>>((uint8_t*)u.data_ptr(),(uint8_t*)q.data_ptr(),(uint8_t*)scale.data_ptr(),
            rows,seq,half,sb,sr,tile,scaleMode); return 0;
    };
    at_npu::native::OpCommand::RunOpApiV2("h3_swiglu_quant_reuse",call); return out;
}
TORCH_LIBRARY(h3_phaa_fusion_quant_reuse,m) { m.def("swiglu_quantize(Tensor u, int tile=4096, int blocks=40, int scale_mode=1) -> (Tensor, Tensor)"); }
TORCH_LIBRARY_IMPL(h3_phaa_fusion_quant_reuse,PrivateUse1,m) { m.impl("swiglu_quantize",&quant_run); }
TORCH_LIBRARY_IMPL(h3_phaa_fusion_quant_reuse,Meta,m) { m.impl("swiglu_quantize",&quant_meta); }
