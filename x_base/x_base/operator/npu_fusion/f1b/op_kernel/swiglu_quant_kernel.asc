#include "kernel_operator.h"
#include "lib/activation/silu.h"

class KernelSwiGLUQuant {
public:
    __aicore__ inline void Init(GM_ADDR u,GM_ADDR q,GM_ADDR scale,uint64_t rows,uint64_t seq,
        uint64_t half,uint64_t sb,uint64_t sr,uint32_t tile,uint32_t scaleMode) {
        rows_=rows; seq_=seq; f_=half; sb_=sb; sr_=sr; tile_=tile; scaleMode_=scaleMode;
        width_=((half+63)/64)*64;
        input_.SetGlobalBuffer((__gm__ bfloat16_t*)u);
        quant_.SetGlobalBuffer((__gm__ int8_t*)q); scales_.SetGlobalBuffer((__gm__ float*)scale);
        pipe_.InitBuffer(hiddenQ_,2,tile*2); pipe_.InitBuffer(gateQ_,2,tile*2);
        pipe_.InitBuffer(bf16_,tile*2);
        pipe_.InitBuffer(hiddenF_,tile*4); pipe_.InitBuffer(gateF_,tile*4); pipe_.InitBuffer(resultF_,tile*4);
        pipe_.InitBuffer(rowF_,width_*4); pipe_.InitBuffer(tempF_,width_*4);
        pipe_.InitBuffer(quantQ_,1,((half+31)/32)*32); pipe_.InitBuffer(scaleQ_,1,32);
    }
    __aicore__ inline void Process() {
        for (uint64_t row=AscendC::GetBlockIdx(); row<rows_; row+=AscendC::GetBlockNum()) {
            for (uint32_t col=0; col<f_; col+=tile_) {
                uint32_t n=(f_-col<tile_)?f_-col:tile_;
                uint64_t offset=(row/seq_)*sb_+(row%seq_)*sr_+col;
                Produce(offset,col,n);
            }
            Quantize(row);
        }
    }
private:
    __aicore__ inline void Produce(uint64_t offset,uint32_t col,uint32_t n) {
        auto h=hiddenQ_.AllocTensor<bfloat16_t>(); auto g=gateQ_.AllocTensor<bfloat16_t>();
        AscendC::DataCopyExtParams cp{1,n*2,0,0,0};
        AscendC::DataCopyPadExtParams<bfloat16_t> pad{false,0,0,0};
        AscendC::DataCopyPad(h,input_[offset],cp,pad); AscendC::DataCopyPad(g,input_[offset+f_],cp,pad);
        hiddenQ_.EnQue(h); gateQ_.EnQue(g);
        h=hiddenQ_.DeQue<bfloat16_t>(); g=gateQ_.DeQue<bfloat16_t>();
        auto hf=hiddenF_.Get<float>(); auto gf=gateF_.Get<float>(); auto rf=resultF_.Get<float>();
        auto rounded=bf16_.Get<bfloat16_t>(); auto row=rowF_.Get<float>();
        AscendC::Cast(hf,h,AscendC::RoundMode::CAST_NONE,n);
        AscendC::Cast(gf,g,AscendC::RoundMode::CAST_NONE,n); AscendC::PipeBarrier<PIPE_V>();
        AscendC::Silu(rf,gf,n); AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(rounded,rf,AscendC::RoundMode::CAST_RINT,n); AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(rf,rounded,AscendC::RoundMode::CAST_NONE,n); AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(rf,hf,rf,n); AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(rounded,rf,AscendC::RoundMode::CAST_RINT,n); AscendC::PipeBarrier<PIPE_V>();
        // Retain exact BF16 SwiGLU values in UB; no full BF16 intermediate in GM.
        AscendC::Cast(row[col],rounded,AscendC::RoundMode::CAST_NONE,n); AscendC::PipeBarrier<PIPE_V>();
        hiddenQ_.FreeTensor(h); gateQ_.FreeTensor(g);
    }
    __aicore__ inline void ReduceMaxInplace(const AscendC::LocalTensor<float>& src,uint32_t count) {
        // Adapted from CANN9.1.0 dynamic_quant_base.h; F<=14336 => repeats<=224.
        uint32_t reps=count/64,offset=reps*64,tail=count%64;
        if (reps>1) {
            AscendC::Max(src,src[64],src,64,reps-1,{1,1,1,0,8,0}); AscendC::PipeBarrier<PIPE_V>();
        }
        if (tail>0 && offset>0) {
            AscendC::Max(src,src[offset],src,tail,1,{1,1,1,0,8,0}); AscendC::PipeBarrier<PIPE_V>();
        }
        AscendC::WholeReduceMax(src,src,reps>0?64:count,1,8,1,8); AscendC::PipeBarrier<PIPE_V>();
    }
    __aicore__ inline void Quantize(uint64_t rowIndex) {
        auto row=rowF_.Get<float>(); auto temp=tempF_.Get<float>();
        auto scalar=gateF_.Get<float>(); auto alphaBuffer=hiddenF_.Get<float>();
        auto q=quantQ_.AllocTensor<int8_t>(); auto scale=scaleQ_.AllocTensor<float>();
        AscendC::Abs(temp,row,f_); AscendC::PipeBarrier<PIPE_V>(); ReduceMaxInplace(temp,f_);
        auto vs=pipe_.FetchEventID(AscendC::HardEvent::V_S);
        AscendC::SetFlag<AscendC::HardEvent::V_S>(vs); AscendC::WaitFlag<AscendC::HardEvent::V_S>(vs);
        float maximum=temp.GetValue(0);
        if (maximum==0.0f) {
            AscendC::Duplicate(q.template ReinterpretCast<int32_t>(),int32_t(0),(f_+3)/4);
            AscendC::Duplicate(scale,0.0f,8);
        } else {
            AscendC::Duplicate(scalar,127.0f,8); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Div(alphaBuffer,scalar,temp,1); AscendC::PipeBarrier<PIPE_V>();
            AscendC::SetFlag<AscendC::HardEvent::V_S>(vs); AscendC::WaitFlag<AscendC::HardEvent::V_S>(vs);
            float alpha=alphaBuffer.GetValue(0);
            if (scaleMode_==1) {
                // Actual production [11585,14336] native scale is max*(float)(1/127).
                AscendC::Muls(scale,temp,float(1.0f/127.0f),1);
            } else {
                // Separate diagnostic for native shapes that use reciprocal-of-alpha.
                AscendC::Duplicate(scalar,1.0f,8); AscendC::PipeBarrier<PIPE_V>();
                AscendC::Div(scale,scalar,alphaBuffer,1);
            }
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(row,row,alpha,f_); AscendC::PipeBarrier<PIPE_V>();
            auto integers=temp.template ReinterpretCast<int32_t>();
            auto halves=temp.template ReinterpretCast<half>();
            AscendC::Cast(integers,row,AscendC::RoundMode::CAST_RINT,f_); AscendC::PipeBarrier<PIPE_V>();
            AscendC::SetDeqScale(half(1.0f)); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(halves,integers,AscendC::RoundMode::CAST_ROUND,f_); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(q,halves,AscendC::RoundMode::CAST_TRUNC,f_);
        }
        quantQ_.EnQue(q); scaleQ_.EnQue(scale);
        q=quantQ_.DeQue<int8_t>(); scale=scaleQ_.DeQue<float>();
        AscendC::DataCopyExtParams qc{1,f_,0,0,0},sc{1,4,0,0,0};
        AscendC::DataCopyPad(quant_[rowIndex*f_],q,qc); AscendC::DataCopyPad(scales_[rowIndex],scale,sc);
        quantQ_.FreeTensor(q); scaleQ_.FreeTensor(scale);
    }
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN,2> hiddenQ_,gateQ_;
    AscendC::TQue<AscendC::QuePosition::VECOUT,1> quantQ_,scaleQ_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> hiddenF_,gateF_,resultF_,bf16_,rowF_,tempF_;
    AscendC::GlobalTensor<bfloat16_t> input_;
    AscendC::GlobalTensor<int8_t> quant_; AscendC::GlobalTensor<float> scales_;
    uint64_t rows_,seq_,sb_,sr_; uint32_t f_,tile_,width_,scaleMode_;
};
extern "C" __global__ __vector__ void h3_swiglu_quant_kernel(GM_ADDR u,GM_ADDR q,GM_ADDR scale,
    uint64_t rows,uint64_t seq,uint64_t half,uint64_t sb,uint64_t sr,uint32_t tile,uint32_t scaleMode) {
    KernelSwiGLUQuant op; op.Init(u,q,scale,rows,seq,half,sb,sr,tile,scaleMode); op.Process();
}
