// Inference-only two-output adapter. The validated AICore implementation is included unchanged.
#include "acl/acl.h"
#include <ATen/ATen.h>
#include <c10/core/DeviceGuard.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/core/npu/NPUCachingAllocator.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#ifdef H3_NQ2_CACHED
#include "../../f2bc/op_kernel/f2bc_cached_kernel.asc"
#define H3_NQ2_KERNEL h3_f2bc_cached_kernel
#define H3_NQ2_NS h3_phaa_nq2_cached
#else
#include "../../f2bc/op_kernel/f2bc_kernel.asc"
#define H3_NQ2_KERNEL h3_f2bc_kernel
#define H3_NQ2_NS h3_phaa_nq2
#endif

static std::tuple<at::Tensor,at::Tensor> nq_meta(const at::Tensor& x,const at::Tensor& w,
    const at::Tensor& s,const at::Tensor& t,const at::Tensor& i,double eps,int64_t blocks) {
 TORCH_CHECK(x.dim()==3 && x.size(2)>0 && x.size(2)<=6144 && x.scalar_type()==at::kBFloat16 && x.stride(2)==1,"BF16 [B,S,H], last stride1, H<=6144 required");
 TORCH_CHECK(w.dim()==1 && w.size(0)==x.size(2) && w.is_contiguous() && (w.scalar_type()==at::kFloat || w.scalar_type()==at::kBFloat16),"BF16/FP32 norm weight [H] required");
 TORCH_CHECK(s.dim()==2 && s.size(0)>0 && s.size(1)==x.size(2) && t.sizes()==s.sizes() && s.scalar_type()==at::kBFloat16 && t.scalar_type()==at::kBFloat16 && s.stride(1)==1 && t.stride(1)==1,"BF16 tables [M,H] required");
 TORCH_CHECK(i.dim()==1 && i.size(0)==x.size(1) && i.scalar_type()==at::kLong && i.is_contiguous(),"contiguous INT64 indices [S] required");
 TORCH_CHECK(eps>0 && eps<1 && blocks>0 && blocks<=40,"invalid epsilon/blocks");
 auto rows=x.size(0)*x.size(1);
 return {at::empty({rows,x.size(2)},x.options().dtype(at::kChar)),at::empty({rows},x.options().dtype(at::kFloat))};
}

static std::tuple<at::Tensor,at::Tensor> nq_run(const at::Tensor& x,const at::Tensor& w,
    const at::Tensor& s,const at::Tensor& t,const at::Tensor& i,double eps,int64_t blocks) {
 TORCH_CHECK(x.is_privateuseone() && w.device()==x.device() && s.device()==x.device() && t.device()==x.device() && i.device()==x.device(),"same NPU required");
 const c10::DeviceGuard guard(x.device());auto o=nq_meta(x,w,s,t,i,eps,blocks);
 if(x.numel()==0)return o;
 auto q=std::get<0>(o),scale=std::get<1>(o);auto stream=c10_npu::getCurrentNPUStream();auto raw=stream.stream(false);
 for(auto v:{x,w,s,t,i,q,scale})c10_npu::NPUCachingAllocator::recordStream(v.storage().data_ptr(),stream);
 uint64_t rows=x.size(0)*x.size(1),seq=x.size(1),width=x.size(2),xb=x.stride(0),xr=x.stride(1),sr=s.stride(0),tr=t.stride(0),tables=s.size(0);
 uint32_t wf=w.scalar_type()==at::kFloat;float avg=1.0f/(float)width;
 // Keep Tensor captures and all stream lifetime protection; no rawref change in this candidate.
 auto call=[x,w,s,t,i,q,scale,raw,rows,seq,width,xb,xr,sr,tr,tables,wf,eps,avg,blocks]()->int {
  H3_NQ2_KERNEL<<<blocks,nullptr,raw>>>((uint8_t*)x.data_ptr(),(uint8_t*)w.data_ptr(),(uint8_t*)s.data_ptr(),(uint8_t*)t.data_ptr(),(uint8_t*)i.data_ptr(),
    (uint8_t*)x.data_ptr(),(uint8_t*)s.data_ptr(),nullptr,nullptr,nullptr,nullptr,nullptr,(uint8_t*)q.data_ptr(),(uint8_t*)scale.data_ptr(),
    rows,seq,width,xb,xr,sr,tr,tables,(float)eps,avg,xb,xr,sr,wf,0,0,0,1);return 0;};
 at_npu::native::OpCommand::RunOpApiV2("h3_norm_affine_quant2",call);return o;
}
#ifdef H3_NQ2_CACHED
TORCH_LIBRARY(h3_phaa_nq2_cached,m){m.def("fused(Tensor x, Tensor weight, Tensor scale, Tensor shift, Tensor indices, float eps=0.00001, int blocks=40) -> (Tensor, Tensor)");}
TORCH_LIBRARY_IMPL(h3_phaa_nq2_cached,PrivateUse1,m){m.impl("fused",&nq_run);}
TORCH_LIBRARY_IMPL(h3_phaa_nq2_cached,Meta,m){m.impl("fused",&nq_meta);}
#else
TORCH_LIBRARY(h3_phaa_nq2,m){m.def("fused(Tensor x, Tensor weight, Tensor scale, Tensor shift, Tensor indices, float eps=0.00001, int blocks=40) -> (Tensor, Tensor)");}
TORCH_LIBRARY_IMPL(h3_phaa_nq2,PrivateUse1,m){m.impl("fused",&nq_run);}
TORCH_LIBRARY_IMPL(h3_phaa_nq2,Meta,m){m.impl("fused",&nq_meta);}
#endif
