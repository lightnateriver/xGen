#include "acl/acl.h"
#include <ATen/ATen.h>
#include <c10/core/DeviceGuard.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/core/npu/NPUCachingAllocator.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "../op_kernel/gate_residual_cached_kernel.asc"
static at::Tensor gate_meta(const at::Tensor& r,const at::Tensor& b,const at::Tensor& g,const at::Tensor& index,int64_t tile,int64_t blocks) {
    TORCH_CHECK(r.dim()==3 && b.sizes()==r.sizes() && r.size(2)>0,"residual/branch [B,S,H] shapes must match");
    TORCH_CHECK(g.dim()==2 && g.size(0)>0 && g.size(1)==r.size(2),"gate_table [M,H] required");
    TORCH_CHECK(index.dim()==1 && index.size(0)==r.size(1) && index.scalar_type()==at::kLong && index.is_contiguous(),"contiguous INT64 indices [S] required");
    TORCH_CHECK(r.scalar_type()==at::kBFloat16 && b.scalar_type()==at::kBFloat16 && g.scalar_type()==at::kBFloat16,"BF16 inputs required");
    TORCH_CHECK(r.stride(2)==1 && b.stride(2)==1 && g.stride(1)==1,"last strides must be 1");
    TORCH_CHECK(r.stride(0)>=0 && r.stride(1)>=0 && b.stride(0)>=0 && b.stride(1)>=0 && g.stride(0)>=0,"nonnegative strides required");
    TORCH_CHECK(tile==1024 || tile==2048 || tile==4096 || tile==5376,"tile must be 1024/2048/4096/5376");
    TORCH_CHECK(blocks>0 && blocks<=40,"blocks must be 1..40");
    return at::empty(r.sizes(),r.options());
}
static at::Tensor gate_run(const at::Tensor& r,const at::Tensor& b,const at::Tensor& g,const at::Tensor& index,int64_t tile,int64_t blocks) {
    TORCH_CHECK(r.is_privateuseone() && b.device()==r.device() && g.device()==r.device() && index.device()==r.device(),"same NPU device required");
    const c10::DeviceGuard guard(r.device());auto out=gate_meta(r,b,g,index,tile,blocks);if (r.numel()==0)return out;
    auto stream=c10_npu::getCurrentNPUStream();auto raw=stream.stream(false);
    for (auto t:{r,b,g,index,out})c10_npu::NPUCachingAllocator::recordStream(t.storage().data_ptr(),stream);
    uint64_t rows=r.size(0)*r.size(1),seq=r.size(1),width=r.size(2),rb=r.stride(0),rr=r.stride(1),bb=b.stride(0),br=b.stride(1),gr=g.stride(0),gateRows=g.size(0);
    auto call=[r,b,g,index,out,raw,rows,seq,width,rb,rr,bb,br,gr,gateRows,tile,blocks]() -> int {
        h3_gate_residual_cached_kernel<<<blocks,nullptr,raw>>>((uint8_t*)r.data_ptr(),(uint8_t*)b.data_ptr(),(uint8_t*)g.data_ptr(),(uint8_t*)index.data_ptr(),(uint8_t*)out.data_ptr(),rows,seq,width,rb,rr,bb,br,gr,gateRows,tile);return 0;
    };
    at_npu::native::OpCommand::RunOpApiV2("h3_gate_residual_cached",call);return out;
}
TORCH_LIBRARY(h3_phaa_gate_residual,m){m.def("gate_residual(Tensor residual, Tensor branch, Tensor gate_table, Tensor indices, int tile=5376, int blocks=40) -> Tensor");}
TORCH_LIBRARY_IMPL(h3_phaa_gate_residual,PrivateUse1,m){m.impl("gate_residual",&gate_run);}
TORCH_LIBRARY_IMPL(h3_phaa_gate_residual,Meta,m){m.impl("gate_residual",&gate_meta);}
