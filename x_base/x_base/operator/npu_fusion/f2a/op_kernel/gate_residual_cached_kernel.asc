#include "kernel_operator.h"

// UB = double-buffer BF16 residual/branch/gate/output (16T), three FP32 (12T), indices (1024).
// Retain gateF_ across tiles with the same (gate index,col,count), reset each launch. No extra UB.
// Keep the BF16 multiply rounding before the residual addition. No FMA substitution.
class KernelH3GateResidualCached {
public:
    __aicore__ inline void Init(GM_ADDR residual,GM_ADDR branch,GM_ADDR gate,GM_ADDR indices,GM_ADDR out,
        uint64_t rows,uint64_t seq,uint64_t width,uint64_t rb,uint64_t rr,uint64_t bb,uint64_t br,
        uint64_t gr,uint64_t gateRows,uint32_t tile) {
        lastGate_=-1;lastCol_=~uint64_t(0);lastCount_=0;rows_=rows;seq_=seq;width_=width;rb_=rb;rr_=rr;bb_=bb;br_=br;gr_=gr;gateRows_=gateRows;tile_=tile;
        residual_.SetGlobalBuffer((__gm__ bfloat16_t*)residual);branch_.SetGlobalBuffer((__gm__ bfloat16_t*)branch);
        gate_.SetGlobalBuffer((__gm__ bfloat16_t*)gate);indices_.SetGlobalBuffer((__gm__ int64_t*)indices);
        out_.SetGlobalBuffer((__gm__ bfloat16_t*)out);
        pipe_.InitBuffer(resQ_,2,tile*2);pipe_.InitBuffer(branchQ_,2,tile*2);pipe_.InitBuffer(gateQ_,2,tile*2);
        pipe_.InitBuffer(outQ_,2,tile*2);pipe_.InitBuffer(resF_,tile*4);pipe_.InitBuffer(branchF_,tile*4);pipe_.InitBuffer(gateF_,tile*4);
        pipe_.InitBuffer(indexBuf_,128*8);
    }
    __aicore__ inline void Process() {
        uint64_t perCore=(rows_+AscendC::GetBlockNum()-1)/AscendC::GetBlockNum();
        uint64_t begin=AscendC::GetBlockIdx()*perCore,end=begin+perCore;
        if (end>rows_) end=rows_;
        auto index=indexBuf_.Get<int64_t>();
        for (uint64_t base=begin;base<end;) {
            uint64_t indexStart=base%seq_;uint32_t n=end-base<128?end-base:128;
            if (n>seq_-indexStart) n=seq_-indexStart;
            AscendC::DataCopyExtParams ip{1,n*8,0,0,0};
            AscendC::DataCopyPadExtParams<int64_t> pad{false,0,0,0};
            AscendC::DataCopyPad(index,indices_[indexStart],ip,pad);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);
            for (uint32_t i=0;i<n;i++) {
                uint64_t row=base+i;int64_t g=index.GetValue(i);
                ASSERT(g>=0 && (uint64_t)g<gateRows_);
                if (g<0 || (uint64_t)g>=gateRows_) return;
                for (uint64_t col=0;col<width_;col+=tile_) {
                    uint32_t count=width_-col<tile_?width_-col:tile_;
                    bool refresh=g!=lastGate_ || col!=lastCol_ || count!=lastCount_;
                    CopyIn(row,g,col,count,refresh);Compute(count,refresh);CopyOut(row*width_+col,count);
                    lastGate_=g;lastCol_=col;lastCount_=count;
                }
            }
            base+=n;
        }
    }
private:
    __aicore__ inline void CopyIn(uint64_t row,uint64_t g,uint64_t col,uint32_t count,bool refresh) {
        auto r=resQ_.AllocTensor<bfloat16_t>();auto b=branchQ_.AllocTensor<bfloat16_t>();
        AscendC::DataCopyExtParams p{1,count*2,0,0,0};AscendC::DataCopyPadExtParams<bfloat16_t> pad{false,0,0,0};
        AscendC::DataCopyPad(r,residual_[(row/seq_)*rb_+(row%seq_)*rr_+col],p,pad);
        AscendC::DataCopyPad(b,branch_[(row/seq_)*bb_+(row%seq_)*br_+col],p,pad);
        AscendC::LocalTensor<bfloat16_t> t;if(refresh){t=gateQ_.AllocTensor<bfloat16_t>();AscendC::DataCopyPad(t,gate_[g*gr_+col],p,pad);}
        resQ_.EnQue(r);branchQ_.EnQue(b);if(refresh)gateQ_.EnQue(t);
    }
    __aicore__ inline void Compute(uint32_t count,bool refresh) {
        auto r=resQ_.DeQue<bfloat16_t>();auto b=branchQ_.DeQue<bfloat16_t>();
        auto out=outQ_.AllocTensor<bfloat16_t>();auto rf=resF_.Get<float>();auto bf=branchF_.Get<float>();auto gf=gateF_.Get<float>();
        AscendC::Cast(rf,r,AscendC::RoundMode::CAST_NONE,count);AscendC::Cast(bf,b,AscendC::RoundMode::CAST_NONE,count);
        AscendC::LocalTensor<bfloat16_t> g;if(refresh){g=gateQ_.DeQue<bfloat16_t>();AscendC::Cast(gf,g,AscendC::RoundMode::CAST_NONE,count);}
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(bf,gf,bf,count);AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(out,bf,AscendC::RoundMode::CAST_RINT,count);AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(bf,out,AscendC::RoundMode::CAST_NONE,count);AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(bf,rf,bf,count);AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(out,bf,AscendC::RoundMode::CAST_RINT,count);
        outQ_.EnQue(out);resQ_.FreeTensor(r);branchQ_.FreeTensor(b);if(refresh)gateQ_.FreeTensor(g);
    }
    __aicore__ inline void CopyOut(uint64_t offset,uint32_t count) {
        auto out=outQ_.DeQue<bfloat16_t>();AscendC::DataCopyExtParams p{1,count*2,0,0,0};
        AscendC::DataCopyPad(out_[offset],out,p);outQ_.FreeTensor(out);
    }
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN,2> resQ_,branchQ_,gateQ_;
    AscendC::TQue<AscendC::QuePosition::VECOUT,2> outQ_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> resF_,branchF_,gateF_,indexBuf_;
    AscendC::GlobalTensor<bfloat16_t> residual_,branch_,gate_,out_;AscendC::GlobalTensor<int64_t> indices_;
    int64_t lastGate_;uint64_t lastCol_;uint32_t lastCount_;
    uint64_t rows_,seq_,width_,rb_,rr_,bb_,br_,gr_,gateRows_;uint32_t tile_;
};
extern "C" __global__ __vector__ void h3_gate_residual_cached_kernel(GM_ADDR residual,GM_ADDR branch,GM_ADDR gate,GM_ADDR indices,GM_ADDR out,
    uint64_t rows,uint64_t seq,uint64_t width,uint64_t rb,uint64_t rr,uint64_t bb,uint64_t br,uint64_t gr,uint64_t gateRows,uint32_t tile) {
    KernelH3GateResidualCached op;op.Init(residual,branch,gate,indices,out,rows,seq,width,rb,rr,bb,br,gr,gateRows,tile);op.Process();
}
