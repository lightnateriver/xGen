#include "kernel_operator.h"
#include "native_reduce_common.h"

class KernelH3F2bc {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR shift,GM_ADDR index,
        GM_ADDR branch,GM_ADDR gate,GM_ADDR residualOut,GM_ADDR norm,GM_ADDR factor,GM_ADDR scaled,GM_ADDR out,GM_ADDR quant,GM_ADDR tokenScale,uint64_t rows,uint64_t seq,uint64_t width,
        uint64_t xb,uint64_t xr,uint64_t sr,uint64_t tr,uint64_t tables,float eps,float avg,uint64_t bb,uint64_t br,uint64_t gr,uint32_t weightFloat,uint32_t debug,uint32_t rstdMode,uint32_t combine,uint32_t quantize) {
        rows_=rows;seq_=seq;h_=width;w_=((width+63)/64)*64;xb_=xb;xr_=xr;sr_=sr;tr_=tr;tables_=tables;eps_=eps;avg_=avg;debug_=debug;mode_=rstdMode;combine_=combine;quantize_=quantize;bb_=bb;br_=br;gr_=gr;
        x_.SetGlobalBuffer((__gm__ bfloat16_t*)x);branch_.SetGlobalBuffer((__gm__ bfloat16_t*)branch);gate_.SetGlobalBuffer((__gm__ bfloat16_t*)gate);residualOut_.SetGlobalBuffer((__gm__ bfloat16_t*)residualOut);quant_.SetGlobalBuffer((__gm__ int8_t*)quant);tokenScale_.SetGlobalBuffer((__gm__ float*)tokenScale);s_.SetGlobalBuffer((__gm__ bfloat16_t*)scale);t_.SetGlobalBuffer((__gm__ bfloat16_t*)shift);
        idx_.SetGlobalBuffer((__gm__ int64_t*)index);norm_.SetGlobalBuffer((__gm__ bfloat16_t*)norm);factor_.SetGlobalBuffer((__gm__ bfloat16_t*)factor);
        scaled_.SetGlobalBuffer((__gm__ bfloat16_t*)scaled);out_.SetGlobalBuffer((__gm__ bfloat16_t*)out);
        pipe_.InitBuffer(loadQ_,1,w_*4);pipe_.InitBuffer(outQ_,1,w_*2);
        pipe_.InitBuffer(rowF_,w_*4);pipe_.InitBuffer(tmpF_,w_*4);pipe_.InitBuffer(gammaF_,w_*4);pipe_.InitBuffer(tableF_,w_*4);
        pipe_.InitBuffer(roundBuf_,w_*2);pipe_.InitBuffer(indexBuf_,1024);pipe_.InitBuffer(scalarBuf_,512);pipe_.InitBuffer(quantQ_,1,((h_+31)/32)*32);pipe_.InitBuffer(scaleQ_,1,32);
        auto g=gammaF_.Get<float>();auto load=loadQ_.AllocTensor<float>();
        if (weightFloat) {
            AscendC::GlobalTensor<float> wg;wg.SetGlobalBuffer((__gm__ float*)weight);
            AscendC::DataCopyExtParams p{1,(uint32_t)h_*4,0,0,0};AscendC::DataCopyPadExtParams<float> pad{false,0,0,0};
            AscendC::DataCopyPad(load,wg,p,pad);loadQ_.EnQue(load);load=loadQ_.DeQue<float>();AscendC::Adds(g,load,0.0f,h_);
        } else {
            AscendC::GlobalTensor<bfloat16_t> wg;wg.SetGlobalBuffer((__gm__ bfloat16_t*)weight);auto bf=load.ReinterpretCast<bfloat16_t>();
            AscendC::DataCopyExtParams p{1,(uint32_t)h_*2,0,0,0};AscendC::DataCopyPadExtParams<bfloat16_t> pad{false,0,0,0};
            AscendC::DataCopyPad(bf,wg,p,pad);loadQ_.EnQue(load);load=loadQ_.DeQue<float>();bf=load.ReinterpretCast<bfloat16_t>();
            AscendC::Cast(g,bf,AscendC::RoundMode::CAST_NONE,h_);
        }
        AscendC::PipeBarrier<PIPE_V>();loadQ_.FreeTensor(load);
    }
    __aicore__ inline void Process() {
        uint64_t per=(rows_+AscendC::GetBlockNum()-1)/AscendC::GetBlockNum(),begin=per*AscendC::GetBlockIdx(),end=begin+per;if(end>rows_)end=rows_;
        auto ids=indexBuf_.Get<int64_t>();
        for (uint64_t base=begin;base<end;) {
            uint32_t n=end-base<128?end-base:128;uint64_t start=base%seq_;if(n>seq_-start)n=seq_-start;
            AscendC::DataCopyExtParams p{1,n*8,0,0,0};AscendC::DataCopyPadExtParams<int64_t> pad{false,0,0,0};
            AscendC::DataCopyPad(ids,idx_[start],p,pad);AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);
            for(uint32_t i=0;i<n;i++) {int64_t g=ids.GetValue(i);ASSERT(g>=0 && (uint64_t)g<tables_);if(g<0 || (uint64_t)g>=tables_)return;Compute(base+i,g);}
            base+=n;
        }
    }
private:
    __aicore__ inline void Load(const AscendC::GlobalTensor<bfloat16_t>& src,uint64_t offset,const AscendC::LocalTensor<float>& dst) {
        auto f=loadQ_.AllocTensor<float>();auto b=f.ReinterpretCast<bfloat16_t>();
        AscendC::DataCopyExtParams p{1,(uint32_t)h_*2,0,0,0};AscendC::DataCopyPadExtParams<bfloat16_t> pad{false,0,0,0};
        AscendC::DataCopyPad(b,src[offset],p,pad);loadQ_.EnQue(f);f=loadQ_.DeQue<float>();b=f.ReinterpretCast<bfloat16_t>();
        AscendC::Cast(dst,b,AscendC::RoundMode::CAST_NONE,h_);AscendC::PipeBarrier<PIPE_V>();loadQ_.FreeTensor(f);
    }
    __aicore__ inline void Round(const AscendC::LocalTensor<float>& f) {
        auto b=roundBuf_.Get<bfloat16_t>();AscendC::Cast(b,f,AscendC::RoundMode::CAST_RINT,h_);AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(f,b,AscendC::RoundMode::CAST_NONE,h_);AscendC::PipeBarrier<PIPE_V>();
    }
    __aicore__ inline void Store(const AscendC::GlobalTensor<bfloat16_t>& dst,uint64_t row,const AscendC::LocalTensor<float>& f) {
        auto b=outQ_.AllocTensor<bfloat16_t>();AscendC::Cast(b,f,AscendC::RoundMode::CAST_RINT,h_);outQ_.EnQue(b);b=outQ_.DeQue<bfloat16_t>();
        AscendC::DataCopyExtParams p{1,(uint32_t)h_*2,0,0,0};AscendC::DataCopyPad(dst[row*h_],b,p);outQ_.FreeTensor(b);
    }
    __aicore__ inline void Compute(uint64_t row,uint64_t table) {
        auto x=rowF_.Get<float>();auto tmp=tmpF_.Get<float>();auto g=gammaF_.Get<float>();auto a=tableF_.Get<float>();auto scalar=scalarBuf_.Get<float>();
        Load(x_,(row/seq_)*xb_+(row%seq_)*xr_,x);
        if(combine_) {
            Load(branch_,(row/seq_)*bb_+(row%seq_)*br_,tmp);Load(gate_,table*gr_,a);
            AscendC::Mul(tmp,tmp,a,h_);AscendC::PipeBarrier<PIPE_V>();Round(tmp);
            AscendC::Add(x,x,tmp,h_);AscendC::PipeBarrier<PIPE_V>();Round(x);Store(residualOut_,row,x);
        }
        AscendC::Mul(tmp,x,x,h_);AscendC::PipeBarrier<PIPE_V>();
        // Copy the installed CANN half-interval reduction unchanged; preserve its operation order.
        if(mode_==0) {
            float sum=ReduceSumHalfInterval(tmp,(int32_t)h_);float inv=1.0f/sqrt(sum*(avg_)+eps_);
            AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
            AscendC::Muls(x,x,inv,h_);
        } else {
            ReduceSumHalfInterval(tmp,tmp,(int32_t)h_);
            AscendC::Muls(tmp,tmp,avg_,8);AscendC::PipeBarrier<PIPE_V>();AscendC::Adds(tmp,tmp,eps_,8);AscendC::PipeBarrier<PIPE_V>();
            if(mode_==1) {
                AscendC::Sqrt(tmp,tmp,8);AscendC::PipeBarrier<PIPE_V>();AscendC::Duplicate(scalar,1.0f,8);AscendC::PipeBarrier<PIPE_V>();AscendC::Div(tmp,scalar,tmp,8);
            } else {AscendC::Rsqrt(tmp,tmp,8);}
            AscendC::PipeBarrier<PIPE_V>();AscendC::Brcb(scalar,tmp,1,{1,8});AscendC::PipeBarrier<PIPE_V>();
            uint32_t reps=h_/64,tail=h_%64;if(reps)AscendC::Mul(x,x,scalar,64,reps,{1,1,0,8,8,0});
            if(tail)AscendC::Mul(x[reps*64],x[reps*64],scalar,tail,1,{1,1,0,8,8,0});
        }
        AscendC::PipeBarrier<PIPE_V>();AscendC::Mul(x,x,g,h_);AscendC::PipeBarrier<PIPE_V>();Round(x);
        if(debug_)Store(norm_,row,x);
        Load(s_,table*sr_,a);AscendC::Adds(a,a,1.0f,h_);AscendC::PipeBarrier<PIPE_V>();Round(a);if(debug_)Store(factor_,row,a);
        AscendC::Mul(x,x,a,h_);AscendC::PipeBarrier<PIPE_V>();Round(x);if(debug_)Store(scaled_,row,x);
        Load(t_,table*tr_,a);AscendC::Add(x,x,a,h_);AscendC::PipeBarrier<PIPE_V>();
        if(quantize_) {Round(x);if(debug_)Store(out_,row,x);Quantize(row,x,tmp,a,scalar);}
        else Store(out_,row,x);
    }
    __aicore__ inline void Quantize(uint64_t row,const AscendC::LocalTensor<float>& x,const AscendC::LocalTensor<float>& tmp,const AscendC::LocalTensor<float>& work,const AscendC::LocalTensor<float>& scalar) {
        AscendC::Abs(tmp,x,h_);AscendC::PipeBarrier<PIPE_V>();
        uint32_t reps=h_/64,tail=h_%64;
        if(reps>1){AscendC::Max(tmp,tmp[64],tmp,64,reps-1,{1,1,1,0,8,0});AscendC::PipeBarrier<PIPE_V>();}
        if(tail && reps){AscendC::Max(tmp,tmp[reps*64],tmp,tail,1,{1,1,1,0,8,0});AscendC::PipeBarrier<PIPE_V>();}
        AscendC::WholeReduceMax(tmp,tmp,reps?64:h_,1,8,1,8);AscendC::PipeBarrier<PIPE_V>();
        AscendC::Brcb(work,tmp,1,{1,8});AscendC::PipeBarrier<PIPE_V>();
        auto scale=scaleQ_.AllocTensor<float>();auto q=quantQ_.AllocTensor<int8_t>();
        AscendC::Muls(scale,work,float(1.0f/127.0f),1);AscendC::Duplicate(scalar,127.0f,8);AscendC::PipeBarrier<PIPE_V>();
        auto alpha=scalar[64];AscendC::Div(alpha,scalar,work,8);AscendC::PipeBarrier<PIPE_V>();
        if(reps)AscendC::Mul(x,x,alpha,64,reps,{1,1,0,8,8,0});
        if(tail)AscendC::Mul(x[reps*64],x[reps*64],alpha,tail,1,{1,1,0,8,8,0});
        AscendC::PipeBarrier<PIPE_V>();auto ints=work.ReinterpretCast<int16_t>();auto halves=work.ReinterpretCast<half>();
        AscendC::Cast(ints,x,AscendC::RoundMode::CAST_RINT,h_);AscendC::PipeBarrier<PIPE_V>();AscendC::SetDeqScale(half(1.0f));AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(halves,ints,AscendC::RoundMode::CAST_ROUND,h_);AscendC::PipeBarrier<PIPE_V>();AscendC::Cast(q,halves,AscendC::RoundMode::CAST_TRUNC,h_);
        quantQ_.EnQue(q);scaleQ_.EnQue(scale);q=quantQ_.DeQue<int8_t>();scale=scaleQ_.DeQue<float>();
        AscendC::DataCopyExtParams qp{1,(uint32_t)h_,0,0,0},sp{1,4,0,0,0};AscendC::DataCopyPad(quant_[row*h_],q,qp);AscendC::DataCopyPad(tokenScale_[row],scale,sp);
        quantQ_.FreeTensor(q);scaleQ_.FreeTensor(scale);
    }
    AscendC::TPipe pipe_;AscendC::TQue<AscendC::QuePosition::VECIN,1> loadQ_;AscendC::TQue<AscendC::QuePosition::VECOUT,1> outQ_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> rowF_,tmpF_,gammaF_,tableF_,roundBuf_,indexBuf_,scalarBuf_;
    AscendC::TQue<AscendC::QuePosition::VECOUT,1> quantQ_,scaleQ_;AscendC::GlobalTensor<int8_t> quant_;AscendC::GlobalTensor<float> tokenScale_;
    AscendC::GlobalTensor<bfloat16_t> branch_,gate_,residualOut_,x_,s_,t_,norm_,factor_,scaled_,out_;AscendC::GlobalTensor<int64_t> idx_;
    uint64_t rows_,seq_,h_,w_,xb_,xr_,sr_,tr_,tables_;float eps_,avg_;uint32_t debug_,mode_,combine_,quantize_;uint64_t bb_,br_,gr_;
};
extern "C" __global__ __vector__ void h3_f2bc_kernel(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR shift,GM_ADDR index,
 GM_ADDR branch,GM_ADDR gate,GM_ADDR residualOut,GM_ADDR norm,GM_ADDR factor,GM_ADDR scaled,GM_ADDR out,GM_ADDR quant,GM_ADDR tokenScale,uint64_t rows,uint64_t seq,uint64_t width,uint64_t xb,uint64_t xr,uint64_t sr,uint64_t tr,uint64_t tables,float eps,float avg,uint64_t bb,uint64_t br,uint64_t gr,uint32_t weightFloat,uint32_t debug,uint32_t mode,uint32_t combine,uint32_t quantize) {
 KernelH3F2bc op;op.Init(x,weight,scale,shift,index,branch,gate,residualOut,norm,factor,scaled,out,quant,tokenScale,rows,seq,width,xb,xr,sr,tr,tables,eps,avg,bb,br,gr,weightFloat,debug,mode,combine,quantize);op.Process();
}
