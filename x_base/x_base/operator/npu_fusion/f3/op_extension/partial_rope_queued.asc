#include <ATen/ATen.h>
#include <c10/core/DeviceGuard.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/core/npu/NPUCachingAllocator.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "../op_kernel/partial_rope_kernel.asc"
using Pair=std::tuple<at::Tensor,at::Tensor>;
static Pair rope_meta(const at::Tensor& q,const at::Tensor& k,const at::Tensor& c,const at::Tensor& s,int64_t tile,int64_t blocks) {
    TORCH_CHECK(q.dim()==4 && q.sizes()==k.sizes() && q.size(3)==128,"Q/K must match [B,S,H,128]");
    TORCH_CHECK(q.scalar_type()==at::kBFloat16 && k.scalar_type()==at::kBFloat16,"BF16 Q/K required");
    TORCH_CHECK(c.dim()==2 && s.sizes()==c.sizes() && c.size(0)==q.size(1) && c.size(1)==96,"cos/sin must be [S,96]");
    TORCH_CHECK(c.scalar_type()==at::kFloat && s.scalar_type()==at::kFloat,"FP32 cos/sin required");
    for(auto t:{q,k}){TORCH_CHECK(t.stride(3)==1 && t.stride(2)>=128 && t.stride(2)<=2147483647,"Q/K require unit last stride and head stride>=128");for(int d=0;d<3;d++)TORCH_CHECK(t.stride(d)>=0,"negative stride unsupported");}
    TORCH_CHECK(c.stride(1)==1 && s.stride(1)==1 && c.stride(0)>=96 && s.stride(0)>=96,"unit last frequency stride required");
    TORCH_CHECK(tile==4 || tile==8 || tile==16 || tile==32,"tile_heads must be 4/8/16/32");
    TORCH_CHECK(blocks>0 && blocks<=40,"blocks must be 1..40");
    return {at::empty(q.sizes(),q.options()),at::empty(k.sizes(),k.options())};
}
static Pair rope_run(const at::Tensor& q,const at::Tensor& k,const at::Tensor& c,const at::Tensor& s,int64_t tile,int64_t blocks) {
    TORCH_CHECK(q.is_privateuseone() && k.device()==q.device() && c.device()==q.device() && s.device()==q.device(),"same NPU device required");
    const c10::DeviceGuard guard(q.device());auto result=rope_meta(q,k,c,s,tile,blocks);auto qo=std::get<0>(result),ko=std::get<1>(result);if(q.numel()==0)return result;
    auto stream=c10_npu::getCurrentNPUStream();auto raw=stream.stream(false);
    for(auto t:{q,k,c,s,qo,ko})c10_npu::NPUCachingAllocator::recordStream(t.storage().data_ptr(),stream);
    uint64_t b=q.size(0),seq=q.size(1),h=q.size(2),qb=q.stride(0),qs=q.stride(1),qh=q.stride(2),kb=k.stride(0),ks=k.stride(1),kh=k.stride(2),cs=c.stride(0),ss=s.stride(0);
    auto call=[q,k,c,s,qo,ko,raw,b,seq,h,qb,qs,qh,kb,ks,kh,cs,ss,tile,blocks]() -> int {
        h3_partial_rope_kernel<<<blocks,nullptr,raw>>>((uint8_t*)q.data_ptr(),(uint8_t*)k.data_ptr(),(uint8_t*)c.data_ptr(),(uint8_t*)s.data_ptr(),(uint8_t*)qo.data_ptr(),(uint8_t*)ko.data_ptr(),b,seq,h,qb,qs,qh,kb,ks,kh,cs,ss,tile);return 0;
    };
    at_npu::native::OpCommand::RunOpApiV2("h3_partial_rope",call);return result;
}
TORCH_LIBRARY(h3_phaa_partial_rope,m){m.def("partial_rope_pair(Tensor q, Tensor k, Tensor cos, Tensor sin, int tile_heads=32, int blocks=40) -> (Tensor, Tensor)");}
TORCH_LIBRARY_IMPL(h3_phaa_partial_rope,PrivateUse1,m){m.impl("partial_rope_pair",&rope_run);}
TORCH_LIBRARY_IMPL(h3_phaa_partial_rope,Meta,m){m.impl("partial_rope_pair",&rope_meta);}
