// Standalone BF16 Partial RoPE. No communication or global workspace.
#include "kernel_operator.h"
class KernelPartialRope {
public:
    __aicore__ inline void Init(GM_ADDR q,GM_ADDR k,GM_ADDR cos,GM_ADDR sin,GM_ADDR qo,GM_ADDR ko,
        uint64_t batch,uint64_t seq,uint64_t heads,uint64_t qb,uint64_t qs,uint64_t qh,
        uint64_t kb,uint64_t ks,uint64_t kh,uint64_t cs,uint64_t ss,uint32_t tileHeads) {
        batch_=batch;seq_=seq;heads_=heads;qb_=qb;qs_=qs;qh_=qh;kb_=kb;ks_=ks;kh_=kh;cs_=cs;ss_=ss;tileHeads_=tileHeads;
        q_.SetGlobalBuffer((__gm__ bfloat16_t*)q);k_.SetGlobalBuffer((__gm__ bfloat16_t*)k);
        qo_.SetGlobalBuffer((__gm__ bfloat16_t*)qo);ko_.SetGlobalBuffer((__gm__ bfloat16_t*)ko);
        cos_.SetGlobalBuffer((__gm__ float*)cos);sin_.SetGlobalBuffer((__gm__ float*)sin);
        uint32_t n=tileHeads*128;
        pipe_.InitBuffer(inQ_,2,n*2);pipe_.InitBuffer(outQ_,2,n*2);
        pipe_.InitBuffer(xF_,n*4);pipe_.InitBuffer(rotF_,n*4);pipe_.InitBuffer(cF_,n*4);pipe_.InitBuffer(sF_,n*4);
        pipe_.InitBuffer(signF_,n*4);pipe_.InitBuffer(rotIndex_,n*4);pipe_.InitBuffer(freqIndex_,n*4);
        pipe_.InitBuffer(cRow_,128*4);pipe_.InitBuffer(sRow_,128*4);
        auto ri=rotIndex_.Get<uint32_t>();auto fi=freqIndex_.Get<uint32_t>();auto signs=signF_.Get<float>();
        for(uint32_t i=0;i<n;i++) {
            uint32_t j=i%128,h=i/128;
            ri.SetValue(i,(h*128+(j<48?j+48:(j<96?j-48:j)))*4);
            fi.SetValue(i,(j<96?j:0)*4);signs.SetValue(i,j<48?-1.0f:1.0f);
        }
        AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
    }
    __aicore__ inline void Process() {
        uint64_t rows=batch_*seq_,per=(rows+AscendC::GetBlockNum()-1)/AscendC::GetBlockNum();
        uint64_t begin=AscendC::GetBlockIdx()*per,end=begin+per;if(end>rows)end=rows;
        for(uint64_t row=begin;row<end;row++) {
            // A previous token's Gather must finish before MTE2 overwrites its tables.
            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::DataCopy(cRow_.Get<float>(),cos_[(row%seq_)*cs_],96);
            AscendC::DataCopy(sRow_.Get<float>(),sin_[(row%seq_)*ss_],96);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            for(uint32_t head=0;head<heads_;head+=tileHeads_) {
                uint32_t h=heads_-head<tileHeads_?heads_-head:tileHeads_,n=h*128;
                auto cf=cF_.Get<float>();auto sf=sF_.Get<float>();auto fi=freqIndex_.Get<uint32_t>();
                AscendC::Gather(cf,cRow_.Get<float>(),fi,0,n);AscendC::Gather(sf,sRow_.Get<float>(),fi,0,n);
                AscendC::PipeBarrier<PIPE_V>();
                Run(q_,qo_,row,head,h,qb_,qs_,qh_);Run(k_,ko_,row,head,h,kb_,ks_,kh_);
            }
        }
    }
private:
    __aicore__ inline void Run(AscendC::GlobalTensor<bfloat16_t>& input,AscendC::GlobalTensor<bfloat16_t>& output,
        uint64_t row,uint32_t head,uint32_t h,uint64_t bs,uint64_t rs,uint64_t hs) {
        uint32_t n=h*128;auto in=inQ_.AllocTensor<bfloat16_t>();
        AscendC::DataCopyExtParams cp{(uint16_t)h,256,(uint32_t)((hs-128)*2),0,0};
        AscendC::DataCopyPadExtParams<bfloat16_t> pad{false,0,0,0};
        AscendC::DataCopyPad(in,input[(row/seq_)*bs+(row%seq_)*rs+head*hs],cp,pad);inQ_.EnQue(in);
        in=inQ_.DeQue<bfloat16_t>();auto out=outQ_.AllocTensor<bfloat16_t>();
        auto xf=xF_.Get<float>();auto rf=rotF_.Get<float>();auto cf=cF_.Get<float>();auto sf=sF_.Get<float>();
        AscendC::Cast(xf,in,AscendC::RoundMode::CAST_NONE,n);AscendC::PipeBarrier<PIPE_V>();
        AscendC::Gather(rf,xf,rotIndex_.Get<uint32_t>(),0,n);AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(rf,rf,signF_.Get<float>(),n);AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(xf,xf,cf,n);AscendC::Mul(rf,rf,sf,n);AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(xf,xf,rf,n);AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(out,xf,AscendC::RoundMode::CAST_RINT,n);AscendC::PipeBarrier<PIPE_V>();
        for(uint32_t i=0;i<h;i++)AscendC::DataCopy(out[i*128+96],in[i*128+96],32);
        outQ_.EnQue(out);inQ_.FreeTensor(in);
        out=outQ_.DeQue<bfloat16_t>();AscendC::DataCopy(output[(row*heads_+head)*128],out,n);outQ_.FreeTensor(out);
    }
    AscendC::TPipe pipe_;AscendC::TQue<AscendC::QuePosition::VECIN,2> inQ_;AscendC::TQue<AscendC::QuePosition::VECOUT,2> outQ_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> xF_,rotF_,cF_,sF_,signF_,rotIndex_,freqIndex_,cRow_,sRow_;
    AscendC::GlobalTensor<bfloat16_t> q_,k_,qo_,ko_;AscendC::GlobalTensor<float> cos_,sin_;
    uint64_t batch_,seq_,heads_,qb_,qs_,qh_,kb_,ks_,kh_,cs_,ss_;uint32_t tileHeads_;
};
extern "C" __global__ __vector__ void h3_partial_rope_kernel(GM_ADDR q,GM_ADDR k,GM_ADDR cos,GM_ADDR sin,GM_ADDR qo,GM_ADDR ko,
    uint64_t batch,uint64_t seq,uint64_t heads,uint64_t qb,uint64_t qs,uint64_t qh,uint64_t kb,uint64_t ks,uint64_t kh,uint64_t cs,uint64_t ss,uint32_t tileHeads) {
    KernelPartialRope op;op.Init(q,k,cos,sin,qo,ko,batch,seq,heads,qb,qs,qh,kb,ks,kh,cs,ss,tileHeads);op.Process();
}
