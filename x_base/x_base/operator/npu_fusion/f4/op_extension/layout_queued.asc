#include "acl/acl.h"
#include <ATen/ATen.h>
#include <ATen/MemoryOverlap.h>
#include <c10/core/DeviceGuard.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/core/npu/NPUCachingAllocator.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "../op_kernel/layout_kernel.asc"
static void check(const at::Tensor& x,const at::Tensor& out,int64_t tile,int64_t blocks) {
 TORCH_CHECK(x.scalar_type()==at::kBFloat16 && out.scalar_type()==at::kBFloat16,"BF16 required");
 TORCH_CHECK(x.device()==out.device() && out.is_contiguous(),"same device, contiguous output required");
 TORCH_CHECK(tile==16 || tile==32 || tile==64 || tile==128,"tile 16/32/64/128 required");
 TORCH_CHECK(blocks>0 && blocks<=40,"1..40 Vector blocks");
 at::assert_no_internal_overlap(out);at::assert_no_overlap(x,out);
}
static void pack_check(const at::Tensor& q,const at::Tensor& k,const at::Tensor& v,const at::Tensor& qo,const at::Tensor& ko,const at::Tensor& vo,int64_t tile,int64_t blocks) {
 for(auto x:{q,k,v}) {
  TORCH_CHECK(x.dim()==4 && x.size(0)==1 && x.size(1)>0 && x.size(2)==56 && x.size(3)==128,"[1,S,56,128] required");
  TORCH_CHECK(x.stride(3)==1 && x.stride(2)==128 && x.stride(1)>=7168 && x.stride(1)<(1LL<<30),"head contiguous and nonoverlapping row stride required");
  TORCH_CHECK(x.sizes()==q.sizes() && x.device()==q.device(),"QKV shapes/devices must match");
  for(auto y:{qo,ko,vo})check(x,y,tile,blocks);
 }
 for(auto y:{qo,ko,vo}) TORCH_CHECK(y.sizes()==at::IntArrayRef({7,4,q.size(1),1,2,128}),"send shape mismatch");
 at::assert_no_overlap(qo,ko);at::assert_no_overlap(qo,vo);at::assert_no_overlap(ko,vo);
}
static void pack(const at::Tensor& q,const at::Tensor& k,const at::Tensor& v,at::Tensor qo,at::Tensor ko,at::Tensor vo,int64_t tile,int64_t blocks) {
 pack_check(q,k,v,qo,ko,vo,tile,blocks);TORCH_CHECK(q.is_privateuseone(),"NPU required");c10::DeviceGuard guard(q.device());
 auto s=c10_npu::getCurrentNPUStream();auto raw=s.stream(false);
 for(auto x:{q,k,v,qo,ko,vo})c10_npu::NPUCachingAllocator::recordStream(x.storage().data_ptr(),s);
 auto fn=[q,k,v,qo,ko,vo,raw,tile,blocks]()->int {
  h3_pack_qkv<<<blocks,nullptr,raw>>>((uint8_t*)q.data_ptr(),(uint8_t*)k.data_ptr(),(uint8_t*)v.data_ptr(),(uint8_t*)qo.data_ptr(),(uint8_t*)ko.data_ptr(),(uint8_t*)vo.data_ptr(),q.size(1),q.stride(1),k.stride(1),v.stride(1),tile);return 0;};
 at_npu::native::OpCommand::RunOpApiV2("h3_pack_qkv",fn);
}
static void back_check(const at::Tensor& x,const at::Tensor& y,int64_t S,int64_t L,int64_t tile,int64_t blocks) {
 check(x,y,tile,blocks);TORCH_CHECK(S>0 && (L==4*S || L==4*S-1),"only zero/one padding token supported");
 TORCH_CHECK(x.sizes()==at::IntArrayRef({1,2,L,128}) && x.stride(3)==1 && x.stride(2)>=128 && x.stride(1)>=128 && x.stride(2)<(1LL<<30),"attn shape/stride mismatch");
 TORCH_CHECK(y.sizes()==at::IntArrayRef({4,S,1,256}),"back_send shape mismatch");
}
static void back(const at::Tensor& x,at::Tensor y,int64_t S,int64_t L,int64_t tile,int64_t blocks) {
 back_check(x,y,S,L,tile,blocks);TORCH_CHECK(x.is_privateuseone(),"NPU required");c10::DeviceGuard guard(x.device());
 auto s=c10_npu::getCurrentNPUStream();auto raw=s.stream(false);for(auto z:{x,y})c10_npu::NPUCachingAllocator::recordStream(z.storage().data_ptr(),s);
 auto fn=[x,y,S,L,tile,blocks,raw]()->int {h3_pack_back<<<blocks,nullptr,raw>>>((uint8_t*)x.data_ptr(),(uint8_t*)y.data_ptr(),S,L,x.stride(1),x.stride(2),tile);return 0;};
 at_npu::native::OpCommand::RunOpApiV2("h3_pack_back",fn);
}
static void merge_check(const at::Tensor& x,const at::Tensor& y,int64_t tile,int64_t blocks) {
 check(x,y,tile,blocks);TORCH_CHECK(x.dim()==5 && x.size(0)==7 && x.size(1)==4 && x.size(2)>0 && x.size(3)==1 && x.size(4)==256 && x.is_contiguous(),"contiguous [7,4,S,1,256] required");
 TORCH_CHECK(y.sizes()==at::IntArrayRef({1,x.size(2),7168}),"merged shape mismatch");
}
static void merge(const at::Tensor& x,at::Tensor y,int64_t tile,int64_t blocks) {
 merge_check(x,y,tile,blocks);TORCH_CHECK(x.is_privateuseone(),"NPU required");c10::DeviceGuard guard(x.device());
 auto s=c10_npu::getCurrentNPUStream();auto raw=s.stream(false);for(auto z:{x,y})c10_npu::NPUCachingAllocator::recordStream(z.storage().data_ptr(),s);
 auto fn=[x,y,tile,blocks,raw]()->int {h3_merge_back<<<blocks,nullptr,raw>>>((uint8_t*)x.data_ptr(),(uint8_t*)y.data_ptr(),x.size(2),tile);return 0;};
 at_npu::native::OpCommand::RunOpApiV2("h3_merge_back",fn);
}
static void pack_meta(const at::Tensor& q,const at::Tensor& k,const at::Tensor& v,at::Tensor qo,at::Tensor ko,at::Tensor vo,int64_t tile,int64_t blocks){pack_check(q,k,v,qo,ko,vo,tile,blocks);}
static void back_meta(const at::Tensor& x,at::Tensor y,int64_t S,int64_t L,int64_t tile,int64_t blocks){back_check(x,y,S,L,tile,blocks);}
static void merge_meta(const at::Tensor& x,at::Tensor y,int64_t tile,int64_t blocks){merge_check(x,y,tile,blocks);}
TORCH_LIBRARY(h3_phaa_layout,m) {
 m.def("pack(Tensor q, Tensor k, Tensor v, Tensor(a!) qo, Tensor(b!) ko, Tensor(c!) vo, int tile=64, int blocks=40) -> ()");
 m.def("back(Tensor x, Tensor(a!) y, int S, int L, int tile=64, int blocks=40) -> ()");
 m.def("merge(Tensor x, Tensor(a!) y, int tile=64, int blocks=40) -> ()");
}
TORCH_LIBRARY_IMPL(h3_phaa_layout,PrivateUse1,m){m.impl("pack",&pack);m.impl("back",&back);m.impl("merge",&merge);}
TORCH_LIBRARY_IMPL(h3_phaa_layout,Meta,m){m.impl("pack",&pack_meta);m.impl("back",&back_meta);m.impl("merge",&merge_meta);}
