// Queue/copy skeleton derived from F1a CANNBot add_custom template; CANN OSL v2.
#include "kernel_operator.h"
// All transfers preserve BF16 bytes. No arithmetic or HCCL in these kernels.
class LayoutCopy {
public:
 __aicore__ inline void Init(GM_ADDR x,GM_ADDR y,uint32_t tile) {
  in.SetGlobalBuffer((__gm__ bfloat16_t*)x);out.SetGlobalBuffer((__gm__ bfloat16_t*)y);
  pipe.InitBuffer(buf,tile*256*2);
 }
 __aicore__ inline void Copy(uint64_t src,uint64_t dst,uint32_t rows,uint32_t width,uint32_t ss,uint32_t ds) {
  auto t=buf.Get<bfloat16_t>();
  AscendC::DataCopyExtParams a{(uint16_t)rows,width*2,(ss-width)*2,0,0};
  AscendC::DataCopyPadExtParams<bfloat16_t> pad{false,0,0,0};
  AscendC::DataCopyPad(t,in[src],a,pad);AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(0);AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(0);
  AscendC::DataCopyExtParams b{(uint16_t)rows,width*2,0,(ds-width)*2,0};
  AscendC::DataCopyPad(out[dst],t,b);AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(0);AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(0);
 }
 __aicore__ inline void Zero(uint64_t dst) {
  AscendC::PipeBarrier<PIPE_ALL>();auto t=buf.Get<bfloat16_t>();AscendC::Duplicate(t.ReinterpretCast<uint16_t>(),(uint16_t)0,256);
  AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);AscendC::DataCopy(out[dst],t,256);AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(0);AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(0);
 }
 AscendC::TPipe pipe;
 AscendC::TBuf<AscendC::QuePosition::VECCALC> buf;
 AscendC::GlobalTensor<bfloat16_t> in,out;
};
extern "C" __global__ __vector__ void h3_pack_one(GM_ADDR x,GM_ADDR y,uint64_t S,uint64_t sr,uint32_t tile) {
 LayoutCopy op;op.Init(x,y,tile);uint64_t nt=(S+tile-1)/tile;
 for(uint64_t job=AscendC::GetBlockIdx();job<28*nt;job+=AscendC::GetBlockNum()) {
  uint64_t c=job/nt/4,d=job/nt%4,s=job%nt*tile;uint32_t n=S-s<tile?S-s:tile;
  op.Copy(s*sr+(d*14+c*2)*128,((c*4+d)*S+s)*256,n,256,sr,256);
 }
}
extern "C" __global__ __vector__ void h3_pack_qkv(GM_ADDR q,GM_ADDR k,GM_ADDR v,GM_ADDR qo,GM_ADDR ko,GM_ADDR vo,
 uint64_t S,uint64_t qs,uint64_t ks,uint64_t vs,uint32_t tile) {
 // One queue per block reused across Q/K/V; block task partition includes tensor index.
 LayoutCopy op;op.Init(q,qo,tile);uint64_t nt=(S+tile-1)/tile;
 for(uint64_t job=AscendC::GetBlockIdx();job<84*nt;job+=AscendC::GetBlockNum()) {
  uint64_t z=job/nt/28,c=job/nt%28/4,d=job/nt%4,s=job%nt*tile;uint32_t n=S-s<tile?S-s:tile;
  uint64_t sr=z==0?qs:z==1?ks:vs;
  op.in.SetGlobalBuffer((__gm__ bfloat16_t*)(z==0?q:z==1?k:v));
  op.out.SetGlobalBuffer((__gm__ bfloat16_t*)(z==0?qo:z==1?ko:vo));
  op.Copy(s*sr+(d*14+c*2)*128,((c*4+d)*S+s)*256,n,256,sr,256);
 }
}
extern "C" __global__ __vector__ void h3_pack_back(GM_ADDR x,GM_ADDR y,uint64_t S,uint64_t L,uint64_t sh,uint64_t st,uint32_t tile) {
 LayoutCopy op;op.Init(x,y,tile);uint64_t nt=(L+tile-1)/tile;
 for(uint64_t job=AscendC::GetBlockIdx();job<2*nt;job+=AscendC::GetBlockNum()) {
  uint64_t h=job/nt,s=job%nt*tile;uint32_t n=L-s<tile?L-s:tile;
  op.Copy(h*sh+s*st,s*256+h*128,n,128,st,256);
 }
 if(AscendC::GetBlockIdx()==0 && L<4*S)op.Zero(L*256);
}
extern "C" __global__ __vector__ void h3_merge_back(GM_ADDR x,GM_ADDR y,uint64_t S,uint32_t tile) {
 LayoutCopy op;op.Init(x,y,tile);uint64_t nt=(S+tile-1)/tile;
 for(uint64_t job=AscendC::GetBlockIdx();job<28*nt;job+=AscendC::GetBlockNum()) {
  uint64_t c=job/nt/4,d=job/nt%4,s=job%nt*tile;uint32_t n=S-s<tile?S-s:tile;
  op.Copy(((c*4+d)*S+s)*256,s*7168+(d*14+c*2)*128,n,256,256,7168);
 }
}
