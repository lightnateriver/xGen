#include "acl/acl.h"
#include <ATen/ATen.h>
#include <c10/core/DeviceGuard.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/core/npu/NPUCachingAllocator.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "../op_kernel/merge_quant_kernel.asc"
static std::tuple<at::Tensor,at::Tensor> meta(const at::Tensor& x,int64_t blocks) {
 TORCH_CHECK(x.dim()==5 && x.size(0)==7 && x.size(1)==4 && x.size(3)==1 && x.size(4)==256,"[7,4,S,1,256] required");
 TORCH_CHECK(x.scalar_type()==at::kBFloat16 && x.is_contiguous(),"contiguous BF16 required");
 TORCH_CHECK(x.size(2)<=(1LL<<20),"S exceeds DataCopy stride contract");
 TORCH_CHECK(blocks>0 && blocks<=40,"blocks must be 1..40");
 return {at::empty({x.size(2),7168},x.options().dtype(at::kChar)),at::empty({x.size(2)},x.options().dtype(at::kFloat))};
}
static std::tuple<at::Tensor,at::Tensor> run(const at::Tensor& x,int64_t blocks) {
 TORCH_CHECK(x.is_privateuseone(),"NPU input required");c10::DeviceGuard guard(x.device());
 auto result=meta(x,blocks);auto q=std::get<0>(result),scale=std::get<1>(result);
 if(x.numel()==0)return result;
 auto stream=c10_npu::getCurrentNPUStream();auto raw=stream.stream(false);
 for(auto v:{x,q,scale})c10_npu::NPUCachingAllocator::recordStream(v.storage().data_ptr(),stream);
 uint64_t seq=x.size(2);
 auto fn=[x,q,scale,seq,blocks,raw]()->int {
  h3_merge_quant_kernel<<<blocks,nullptr,raw>>>((uint8_t*)x.data_ptr(),(uint8_t*)q.data_ptr(),(uint8_t*)scale.data_ptr(),seq);return 0;};
 at_npu::native::OpCommand::RunOpApiV2("h3_merge_quant",fn);return result;
}
TORCH_LIBRARY(h3_phaa_merge_quant,m){m.def("fused(Tensor back_recv, int blocks=40) -> (Tensor, Tensor)");}
TORCH_LIBRARY_IMPL(h3_phaa_merge_quant,PrivateUse1,m){m.impl("fused",&run);}
TORCH_LIBRARY_IMPL(h3_phaa_merge_quant,Meta,m){m.impl("fused",&meta);}
