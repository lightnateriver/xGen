/**
 * Based on CANNBot Vector template and installed CANN DynamicQuant reduction/cast sequence.
 * Copyright (c) 2025-2026 Huawei Technologies Co., Ltd. CANN OSL v2 applies to adapted portions.
 */
// X5: original PHAA owner/chunk/lane order plus native-compatible row DQ.
#include "kernel_operator.h"
class KernelMergeQuant {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR q,GM_ADDR scale,uint64_t seq) {
        seq_=seq;
        input_.SetGlobalBuffer((__gm__ bfloat16_t*)x);
        quant_.SetGlobalBuffer((__gm__ int8_t*)q);
        scales_.SetGlobalBuffer((__gm__ float*)scale);
        pipe_.InitBuffer(inputQ_,1,7168*2);
        pipe_.InitBuffer(rowF_,7168*4);
        pipe_.InitBuffer(tempF_,7168*4);
        pipe_.InitBuffer(quantQ_,1,7168);
        pipe_.InitBuffer(scaleQ_,1,32);
    }
    __aicore__ inline void Process() {
        for(uint64_t row=AscendC::GetBlockIdx();row<seq_;row+=AscendC::GetBlockNum()) {
            auto in=inputQ_.AllocTensor<bfloat16_t>();
            // Each owner's seven chunk stripes are contiguous in the output row.
            // GM stride is bytes, matching the existing F4 DataCopyPad contract.
            AscendC::DataCopyExtParams cp{7,512,(uint32_t)((4*seq_-1)*512),0,0};
            AscendC::DataCopyPadExtParams<bfloat16_t> pad{false,0,0,0};
            for(uint32_t owner=0;owner<4;++owner) {
                AscendC::DataCopyPad(in[owner*1792],input_[(owner*seq_+row)*256],cp,pad);
            }
            inputQ_.EnQue(in);
            in=inputQ_.DeQue<bfloat16_t>();
            AscendC::Cast(rowF_.Get<float>(),in,AscendC::RoundMode::CAST_NONE,7168);
            AscendC::PipeBarrier<PIPE_V>();
            inputQ_.FreeTensor(in);
            Quantize(row);
        }
    }
private:
    __aicore__ inline void ReduceMaxInplace(const AscendC::LocalTensor<float>& src,uint32_t count) {
        // Adapted from CANN9.1.0 dynamic_quant_base.h; F<=14336 => repeats<=224.
        uint32_t reps=count/64,offset=reps*64,tail=count%64;
        if (reps>1) {
            AscendC::Max(src,src[64],src,64,reps-1,{1,1,1,0,8,0}); AscendC::PipeBarrier<PIPE_V>();
        }
        if (tail>0 && offset>0) {
            AscendC::Max(src,src[offset],src,tail,1,{1,1,1,0,8,0}); AscendC::PipeBarrier<PIPE_V>();
        }
        AscendC::WholeReduceMax(src,src,reps>0?64:count,1,8,1,8); AscendC::PipeBarrier<PIPE_V>();
    }
    __aicore__ inline void Quantize(uint64_t rowIndex) {
        auto row=rowF_.Get<float>(); auto temp=tempF_.Get<float>();
        auto broadcast=temp[tile_]; auto alpha=temp[2*tile_];
        auto constant=temp;
        auto q=quantQ_.AllocTensor<int8_t>(); auto scale=scaleQ_.AllocTensor<float>();
        AscendC::Abs(temp,row,f_); AscendC::PipeBarrier<PIPE_V>(); ReduceMaxInplace(temp,f_);
        AscendC::Brcb(broadcast,temp,1,{1,8}); AscendC::PipeBarrier<PIPE_V>();
        AscendC::Duplicate(constant,127.0f,8); AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(alpha,constant,broadcast,8); AscendC::PipeBarrier<PIPE_V>();
        // Follow the installed BF16 DynamicQuant DB path, including its native cast behavior.
        // No GetValue, V_S wait, or separate mask/Select helper per row.
        if (scaleMode_==1) {
            AscendC::Muls(scale,broadcast,float(1.0f/127.0f),1);
        } else {
            AscendC::Duplicate(constant,1.0f,8); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Div(scale,constant,alpha,8);
        }
        AscendC::PipeBarrier<PIPE_V>();
        uint32_t repeats=f_/64,tail=f_%64;
        if (repeats>0) {
            AscendC::Mul(row,row,alpha,64,repeats,{1,1,0,8,8,0});
        }
        if (tail>0) {
            AscendC::Mul(row[repeats*64],row[repeats*64],alpha,tail,1,{1,1,0,8,8,0});
        }
        AscendC::PipeBarrier<PIPE_V>();
        auto integers=temp.template ReinterpretCast<int16_t>();
        auto halves=temp.template ReinterpretCast<half>();
        AscendC::Cast(integers,row,AscendC::RoundMode::CAST_RINT,f_); AscendC::PipeBarrier<PIPE_V>();
        AscendC::SetDeqScale(half(1.0f)); AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(halves,integers,AscendC::RoundMode::CAST_ROUND,f_); AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(q,halves,AscendC::RoundMode::CAST_TRUNC,f_);
        quantQ_.EnQue(q); scaleQ_.EnQue(scale);
        q=quantQ_.DeQue<int8_t>(); scale=scaleQ_.DeQue<float>();
        AscendC::DataCopyExtParams qc{1,f_,0,0,0},sc{1,4,0,0,0};
        AscendC::DataCopyPad(quant_[rowIndex*f_],q,qc); AscendC::DataCopyPad(scales_[rowIndex],scale,sc);
        quantQ_.FreeTensor(q); scaleQ_.FreeTensor(scale);
    }
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN,1> inputQ_;
    AscendC::TQue<AscendC::QuePosition::VECOUT,1> quantQ_,scaleQ_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> rowF_,tempF_;
    AscendC::GlobalTensor<bfloat16_t> input_;
    AscendC::GlobalTensor<int8_t> quant_;
    AscendC::GlobalTensor<float> scales_;
    uint64_t seq_;
    uint32_t f_=7168,tile_=1024,scaleMode_=1;
};
extern "C" __global__ __vector__ void h3_merge_quant_kernel(GM_ADDR x,GM_ADDR q,GM_ADDR scale,uint64_t seq) {
    KernelMergeQuant op;op.Init(x,q,scale,seq);op.Process();
}
