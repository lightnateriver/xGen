#include "acl/acl.h"
#include <ATen/ATen.h>
#include <c10/core/DeviceGuard.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/core/npu/NPUCachingAllocator.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "../op_kernel/preprocess_kernel.asc"
static std::tuple<at::Tensor,at::Tensor,at::Tensor> meta(const at::Tensor& q,const at::Tensor& k,const at::Tensor& v,int64_t tile,int64_t blocks) {
 TORCH_CHECK(tile==16 || tile==32 || tile==64 || tile==128,"tile16/32/64/128 required");
 TORCH_CHECK(blocks>0 && blocks<=40,"1..40 blocks required");
 for(auto x:{q,k,v}){
  TORCH_CHECK(x.dim()==4 && x.size(0)==1 && x.size(1)==2 && x.size(2)>0 && x.size(3)==128 && x.scalar_type()==at::kBFloat16,"BF16 [1,2,L,128] required");
  TORCH_CHECK(x.sizes()==q.sizes() && x.device()==q.device() && x.stride(3)==1 && x.stride(2)>=128 && x.stride(2)<(1LL<<30) && x.stride(1)>=0,"QKV shape/device/stride mismatch");
 }
 int64_t Lp=(q.size(2)+255)/256*256;auto opts=q.options().dtype(at::kHalf);
 return {at::empty({1,2,Lp,128},opts),at::empty({1,2,Lp,128},opts),at::empty({1,2,Lp,128},opts)};
}
static std::tuple<at::Tensor,at::Tensor,at::Tensor> run(const at::Tensor& q,const at::Tensor& k,const at::Tensor& v,int64_t tile,int64_t blocks) {
 TORCH_CHECK(q.is_privateuseone(),"NPU required");c10::DeviceGuard guard(q.device());auto ys=meta(q,k,v,tile,blocks);
 auto qo=std::get<0>(ys),ko=std::get<1>(ys),vo=std::get<2>(ys);auto s=c10_npu::getCurrentNPUStream();auto raw=s.stream(false);
 for(auto x:{q,k,v,qo,ko,vo})c10_npu::NPUCachingAllocator::recordStream(x.storage().data_ptr(),s);
 auto call=[q,k,v,qo,ko,vo,tile,blocks,raw]()->int {
  h3_phaa_preprocess<<<blocks,nullptr,raw>>>((uint8_t*)q.data_ptr(),(uint8_t*)k.data_ptr(),(uint8_t*)v.data_ptr(),(uint8_t*)qo.data_ptr(),(uint8_t*)ko.data_ptr(),(uint8_t*)vo.data_ptr(),q.size(2),qo.size(2),q.stride(1),q.stride(2),k.stride(1),k.stride(2),v.stride(1),v.stride(2),tile);return 0;};
 at_npu::native::OpCommand::RunOpApiV2("h3_phaa_preprocess",call);return ys;
}
TORCH_LIBRARY(h3_phaa_preprocess,m){m.def("run(Tensor q, Tensor k, Tensor v, int tile=64, int blocks=40) -> (Tensor,Tensor,Tensor)");}
TORCH_LIBRARY_IMPL(h3_phaa_preprocess,PrivateUse1,m){m.impl("run",&run);}
TORCH_LIBRARY_IMPL(h3_phaa_preprocess,Meta,m){m.impl("run",&meta);}
