// Derived from F4/F1a direct invoke scaffolding. Original CANN OSL v2 applies.
#include "kernel_operator.h"
class Preprocess {
public:
 __aicore__ inline void Init(uint32_t tile) {
  tile_=tile;span_=tile*128;
  pipe.InitBuffer(inbuf,span_*2);pipe.InitBuffer(fpbuf,span_*4);pipe.InitBuffer(outbuf,span_*2);
 }
 __aicore__ inline void Process(GM_ADDR q,GM_ADDR k,GM_ADDR v,GM_ADDR qo,GM_ADDR ko,GM_ADDR vo,
  uint64_t L,uint64_t Lp,uint64_t qh,uint64_t qt,uint64_t kh,uint64_t kt,uint64_t vh,uint64_t vt) {
  uint64_t nt=(Lp+tile_-1)/tile_;
  for(uint64_t j=AscendC::GetBlockIdx();j<6*nt;j+=AscendC::GetBlockNum()) {
   uint64_t z=j/nt/2,h=j/nt%2,s=j%nt*tile_;
   uint32_t rows=Lp-s<tile_?Lp-s:tile_;uint32_t valid=s<L?(L-s<rows?L-s:rows):0;
   input.SetGlobalBuffer((__gm__ bfloat16_t*)(z==0?q:z==1?k:v));
   output.SetGlobalBuffer((__gm__ half*)(z==0?qo:z==1?ko:vo));
   uint64_t sh=z==0?qh:z==1?kh:vh,st=z==0?qt:z==1?kt:vt;
   auto a=inbuf.Get<bfloat16_t>();auto f=fpbuf.Get<float>();auto y=outbuf.Get<half>();
   if(valid) {
    AscendC::DataCopyExtParams p{(uint16_t)valid,256,(uint32_t)((st-128)*2),0,0};
    AscendC::DataCopyPadExtParams<bfloat16_t> pad{false,0,0,0};
    AscendC::DataCopyPad(a,input[h*sh+s*st],p,pad);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);
    AscendC::Cast(f,a,AscendC::RoundMode::CAST_NONE,valid*128);AscendC::PipeBarrier<PIPE_V>();
    AscendC::Cast(y,f,AscendC::RoundMode::CAST_RINT,valid*128);AscendC::PipeBarrier<PIPE_V>();
   }
   if(valid<rows)AscendC::Duplicate(y.ReinterpretCast<uint16_t>()[valid*128],(uint16_t)0,(rows-valid)*128);
   AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
   AscendC::DataCopyExtParams out{1,rows*256,0,0,0};AscendC::DataCopyPad(output[h*Lp*128+s*128],y,out);
   AscendC::PipeBarrier<PIPE_ALL>();
  }
 }
 AscendC::TPipe pipe;AscendC::TBuf<AscendC::QuePosition::VECCALC> inbuf,fpbuf,outbuf;
 AscendC::GlobalTensor<bfloat16_t> input;AscendC::GlobalTensor<half> output;uint32_t tile_,span_;
};
extern "C" __global__ __vector__ void h3_phaa_preprocess(GM_ADDR q,GM_ADDR k,GM_ADDR v,GM_ADDR qo,GM_ADDR ko,GM_ADDR vo,
 uint64_t L,uint64_t Lp,uint64_t qh,uint64_t qt,uint64_t kh,uint64_t kt,uint64_t vh,uint64_t vt,uint32_t tile) {
 Preprocess op;op.Init(tile);op.Process(q,k,v,qo,ko,vo,L,Lp,qh,qt,kh,kt,vh,vt);
}
